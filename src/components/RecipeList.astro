---
import { totalTime } from '../lib/recipes';
const { recipes, selectedSlug } = Astro.props;
---
<aside class="sidebar" aria-label="Receptenlijst">
  <a class="brand" href={import.meta.env.BASE_URL} aria-label="Dagkost home">dagkost<span>.</span></a>
  <p class="tagline">Snel, gezond<br />en vooral lekker.</p>
  <div class="search-wrap">
    <label class="sr-only" for="recipe-search">Zoek een recept</label>
    <input id="recipe-search" type="search" placeholder="Zoek een recept" autocomplete="off" />
  </div>
  <nav class="recipe-nav" aria-label="Alle recepten">
    <p class="list-label">Alle recepten <span>{recipes.length}</span></p>
    <ul id="recipe-list">
      {recipes.map((recipe) => (
        <li data-search={`${recipe.data.title} ${recipe.data.description} ${recipe.data.tags.join(' ')} ${recipe.data.diet.join(' ')}`.toLowerCase()}>
          <a class:list={["recipe-link", { selected: recipe.slug === selectedSlug }]} href={`${import.meta.env.BASE_URL}/recepten/${recipe.slug}/`}>
            <span>{recipe.data.title}</span><small>{totalTime(recipe)} min</small>
          </a>
        </li>
      ))}
    </ul>
    <p id="no-results" hidden>Geen recepten gevonden.</p>
  </nav>
  <footer>Dagkost · recepten voor elke dag</footer>
</aside>

<script>
  const input = document.querySelector<HTMLInputElement>('#recipe-search');
  const items = Array.from(document.querySelectorAll<HTMLElement>('#recipe-list li'));
  const noResults = document.querySelector<HTMLElement>('#no-results');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    items.forEach((item) => {
      const show = !query || item.dataset.search?.includes(query);
      item.hidden = !show;
      if (show) visible++;
    });
    if (noResults) noResults.hidden = visible !== 0;
  });
</script>

<style>
  .sidebar { background:var(--cream); min-height:100vh; padding:2.3rem 2rem 1.5rem; display:flex; flex-direction:column; position:sticky; top:0; height:100vh; overflow:auto; }
  .brand { font-family:Georgia,serif; color:var(--ink); text-decoration:none; letter-spacing:-.08em; font-size:2.4rem; font-weight:700; line-height:.9; }.brand span{color:var(--tomato)}
  .tagline { margin:.8rem 0 2.6rem; font-family:Georgia,serif; font-size:1.1rem; line-height:1.18; }
  .search-wrap input { width:100%; border:1px solid var(--line); border-radius:0; background:var(--white); padding:.75rem .8rem; color:var(--ink); }
  .search-wrap input:focus { outline:2px solid var(--tomato); outline-offset:2px; }
  .list-label { display:flex; justify-content:space-between; margin:2rem 0 .65rem; font-weight:700; font-size:.8rem; text-transform:uppercase; letter-spacing:.08em; }.list-label span{color:var(--muted)}
  ul { list-style:none; padding:0; margin:0; border-top:1px solid var(--line); }.recipe-link { display:flex; justify-content:space-between; gap:.6rem; text-decoration:none; padding:.85rem 0; border-bottom:1px solid var(--line); font-family:Georgia,serif; line-height:1.15; }.recipe-link:hover,.recipe-link.selected { color:var(--tomato); }.recipe-link small { font-family:inherit; color:var(--muted); white-space:nowrap; }
  #no-results { color:var(--muted); font-size:.9rem; } footer { margin-top:auto; padding-top:2rem; font-size:.75rem; color:var(--muted); }
  @media (max-width: 800px) { .sidebar { position:static; height:auto; min-height:auto; padding:1.3rem 1.25rem; }.tagline { margin:.4rem 0 1.25rem; }.recipe-nav, footer { display:none; } }
</style>
