---
import { totalTime } from '../lib/recipes';
const { recipe, cookingMode = false } = Astro.props;
const { data } = recipe;
---
<article class:list={["recipe", { cooking: cookingMode }]} data-recipe={recipe.slug} data-servings={data.servings}>
  <header class="recipe-header">
    <p class="eyebrow">{data.tags.slice(0, 2).join(' · ')}</p>
    <h1>{data.title}</h1>
    <p class="intro">{data.description}</p>
    <dl class="meta"><div><dt>Klaar in</dt><dd>{totalTime(recipe)} min</dd></div><div><dt>Voor</dt><dd><span data-serving-count>{data.servings}</span> personen</dd></div></dl>
    {!cookingMode && <a class="cook-button" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/recepten/${recipe.slug}/koken/`}>Start kookmodus <span>→</span></a>}
  </header>
  <div class="recipe-body">
    <section class="ingredients" aria-labelledby="ingredienten">
      <div class="section-heading"><h2 id="ingredienten">Ingrediënten</h2><div class="portion-control"><button type="button" data-action="minus" aria-label="Eén persoon minder">−</button><span><strong data-serving-count>{data.servings}</strong> pers.</span><button type="button" data-action="plus" aria-label="Eén persoon meer">+</button></div></div>
      <ul>
        {data.ingredients.map((ingredient) => <li><label><input type="checkbox" /><span class="checkmark" aria-hidden="true"></span><span>{ingredient.amount && <b data-amount={ingredient.amount}>{ingredient.amount}</b>}{ingredient.unit && <> <span data-unit>{ingredient.unit}</span></>} {ingredient.item}{ingredient.note && <em>, {ingredient.note}</em>}</span></label></li>)}
      </ul>
    </section>
    <section class="steps" aria-labelledby="bereiding">
      <h2 id="bereiding">Bereiding</h2>
      <ol>{data.steps.map((step, index) => <li><span class="step-no">{index + 1}</span><p>{step}</p></li>)}</ol>
      {data.notes.length > 0 && <aside class="note"><strong>Goed om te weten</strong>{data.notes.map((note) => <p>{note}</p>)}</aside>}
    </section>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-recipe]').forEach((recipe) => {
    const baseServings = Number(recipe.dataset.servings);
    let servings = baseServings;
    const update = () => {
      recipe.querySelectorAll<HTMLElement>('[data-serving-count]').forEach((el) => el.textContent = String(servings));
      recipe.querySelectorAll<HTMLElement>('[data-amount]').forEach((el) => {
        const original = Number(el.dataset.amount);
        const value = original * servings / baseServings;
        el.textContent = Number.isInteger(value) ? String(value) : String(Math.round(value * 10) / 10).replace('.', ',');
      });
    };
    recipe.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((button) => button.addEventListener('click', () => {
      const direction = button.dataset.action === 'plus' ? 1 : -1;
      servings = Math.max(1, Math.min(12, servings + direction)); update();
    }));
  });
</script>

<style>
  .recipe { max-width:950px; padding:6.5rem clamp(1.5rem, 7vw, 6rem) 5rem; margin:auto; }.recipe-header { max-width:700px; }.recipe h1 { font-family:Georgia,serif; font-size:clamp(3rem,7vw,5.7rem); letter-spacing:-.07em; line-height:.91; margin:.55rem 0 1.6rem; }.intro { font:1.28rem/1.45 Georgia,serif; max-width:590px; margin:0; }.meta { display:flex; gap:2.8rem; margin:2rem 0; }.meta div { display:grid; gap:.2rem; }.meta dt { color:var(--muted); font-size:.8rem; }.meta dd { margin:0; font-weight:700; }.cook-button { display:inline-flex; align-items:center; gap:1rem; background:var(--tomato); color:white; text-decoration:none; padding:.9rem 1.1rem; font-weight:700; }.cook-button span{font-size:1.25rem}.recipe-body { display:grid; grid-template-columns:minmax(250px,.8fr) minmax(0,1.2fr); gap:clamp(2.5rem,6vw,6rem); margin-top:5.2rem; }.section-heading { display:flex; gap:1rem; align-items:center; justify-content:space-between; }.recipe h2 { font-family:Georgia,serif; font-size:1.7rem; letter-spacing:-.04em; margin:0 0 1.2rem; }.portion-control { display:flex; align-items:center; gap:.45rem; font-size:.8rem; white-space:nowrap; }.portion-control button { width:1.7rem; height:1.7rem; border:1px solid var(--ink); border-radius:50%; background:transparent; cursor:pointer; font-size:1.1rem; color:var(--ink); }.portion-control button:hover{background:var(--ink);color:white}.ingredients ul { list-style:none; padding:0; margin:0; border-top:1px solid var(--line); }.ingredients li { border-bottom:1px solid var(--line); }.ingredients label { display:flex; align-items:flex-start; gap:.65rem; padding:.75rem 0; line-height:1.35; cursor:pointer; }.ingredients input { position:absolute; opacity:0; }.checkmark { display:block; flex:0 0 1.05rem; width:1.05rem; height:1.05rem; border:1px solid var(--ink); margin-top:.12rem; }.ingredients input:checked + .checkmark { background:var(--tomato); border-color:var(--tomato); box-shadow:inset 0 0 0 3px var(--paper); }.ingredients input:checked ~ span:last-child { text-decoration:line-through; color:var(--muted); } em { color:var(--muted); font-size:.92em; }.steps ol { list-style:none; padding:0; margin:0; counter-reset:step; }.steps li { display:grid; grid-template-columns:2.5rem 1fr; gap:1rem; padding:0 0 1.4rem; }.step-no { color:var(--tomato); font-family:Georgia,serif; font-size:1.45rem; font-weight:700; }.steps p { margin:0; line-height:1.6; }.note { background:var(--lemon); padding:1.2rem 1.4rem; margin-top:1rem; }.note p { margin:.5rem 0 0; }.cooking { padding-top:2.5rem; }.cooking .recipe-body { margin-top:3.5rem; }.cooking .recipe-header { max-width:800px; }.cooking .recipe h1 { font-size:clamp(3rem, 9vw, 6rem); }
  @media (max-width:800px) { .recipe { padding:3rem 1.25rem; }.recipe-body { grid-template-columns:1fr; margin-top:3.5rem; }.recipe h1 { font-size:clamp(3rem,14vw,4.5rem); }.cooking { padding-top:1.75rem; } }
  @media (min-width:801px) { .cooking .recipe-body { grid-template-columns:minmax(270px,.75fr) minmax(0,1.25fr); }.cooking .steps p,.cooking .ingredients label { font-size:1.13rem; } }
</style>
