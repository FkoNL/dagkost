---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RecipeList from '../../components/RecipeList.astro';
import RecipeDetail from '../../components/RecipeDetail.astro';
import { getRecipes } from '../../lib/recipes';
export async function getStaticPaths() {
  const recipes = await getRecipes('nonna');
  return recipes.map((recipe) => ({ params: { slug: recipe.slug }, props: { recipe, recipes } }));
}
const { recipe, recipes } = Astro.props;
---
<BaseLayout title={`${recipe.data.title} — Nonna`}>
  <main class="app-shell"><RecipeList collection="nonna" {recipes} selectedSlug={recipe.slug} /><RecipeDetail collection="nonna" {recipe} /></main>
</BaseLayout>
<style>.app-shell { display:grid; grid-template-columns:330px minmax(0,1fr); min-height:100vh; } @media(max-width:800px){.app-shell{display:block}}</style>
